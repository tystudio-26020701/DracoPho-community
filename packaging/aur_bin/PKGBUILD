# Maintainer: tystudio-26020701 <tystudio-26020701@users.noreply.github.com>
# Binary package: downloads prebuilt pacman package from GitHub Release.
# Source package dracoPho builds from source; dracoPho-bin installs prebuilt binary.
pkgname=dracoPho-bin
pkgver=26.8.5.1
pkgrel=1
pkgdesc='Qt 6 Wayland screenshot selection and annotation tool (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/tystudio-26020701/DracoPho-community'
license=('MIT')
depends=('qt6-base' 'qt6-wayland' 'pipewire' 'grim' 'wl-clipboard' 'hicolor-icon-theme' 'python' 'libxcomposite')
# x86_64 由 arch 容器编译，包含 layer-shell-qt 与 ffmpeg 录制支持；aarch64 由 ubuntu 编译，禁用了 layer-shell 和 libav 录制
# depends_x86_64 在 depends 基础上追加，不是替换
depends_x86_64=('layer-shell-qt' 'ffmpeg')
optdepends=(
    'xdg-desktop-portal: portal-based screenshot and screencast backend'
    'xclip: X11 clipboard backend'
    'python-rapidocr: preferred OCR backend'
    'python-pillow: image processing for code scanning'
    'python-zxing-cpp: preferred QR/barcode scanning backend'
    'tesseract: fallback OCR backend'
)
provides=('dracoPho')
conflicts=('dracoPho')

# Release 资产命名规则: dracoPho-bin-${pkgver}-1-${arch}.pkg.tar.zst
# noextract 阻止 makepkg 自动解压 .pkg.tar.zst，package() 里手动 bsdtar 解压
source_x86_64=("https://github.com/tystudio-26020701/DracoPho-community/releases/download/v${pkgver}/dracoPho-bin-${pkgver}-1-x86_64.pkg.tar.zst")
source_aarch64=("https://github.com/tystudio-26020701/DracoPho-community/releases/download/v${pkgver}/dracoPho-bin-${pkgver}-1-aarch64.pkg.tar.zst")
noextract=("dracoPho-bin-${pkgver}-1-x86_64.pkg.tar.zst" "dracoPho-bin-${pkgver}-1-aarch64.pkg.tar.zst")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')
options=('!strip')

# 解压预编译 pacman 包到 pkgdir，排除包元数据文件
# $CARCH 由 makepkg 设置为当前目标架构（x86_64 或 aarch64）
package() {
    bsdtar -xf "${srcdir}/dracoPho-bin-${pkgver}-1-${CARCH}.pkg.tar.zst" -C "${pkgdir}" \
        --exclude='.PKGINFO' \
        --exclude='.MTREE' \
        --exclude='.BUILDINFO'
}
